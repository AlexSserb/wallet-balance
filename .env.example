# Template for production environment — copy to .env and fill in secrets.
# For local development no .env is needed: docker-compose uses built-in defaults.

# PostgreSQL credentials
POSTGRES_USER=wallet
POSTGRES_PASSWORD=
POSTGRES_DB=wallet_db

# SQLAlchemy async DSN (assembled from the vars above by docker-compose)
DATABASE_URL=

# Connection pool (per worker process; total = POOL_SIZE * workers)
POOL_SIZE=5
MAX_OVERFLOW=5

# development | production  (affects log format)
APP_ENV=production